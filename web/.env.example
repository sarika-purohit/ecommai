# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The agent on Cloud Run, e.g. https://ecommai-agent-xxxx.a.run.app (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=

# 1 = use the built-in sample data instead of the agent. Also used when NEXT_PUBLIC_API_BASE_URL is empty.
NEXT_PUBLIC_USE_MOCK=
