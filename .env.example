# Copy this file to .env and fill in the values. Never commit .env.

# Google Cloud
GOOGLE_CLOUD_PROJECT=
# Same project ID; local tools bill their API calls to it
GOOGLE_CLOUD_QUOTA_PROJECT=
# Gemini 3.x models use the global endpoint
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
FIRESTORE_LOCATION=asia-south1
GCS_BUCKET=ecommai-catalog
# Private bucket for shoppers' uploaded photos (deleted after the search, and after 1 day at the latest)
UPLOAD_BUCKET=
# Private bucket for Vertex AI batch job files (deleted after 30 days)
BATCH_BUCKET=
BIGQUERY_DATASET=ecommai
MODEL_ARMOR_LOCATION=asia-south1
MODEL_ARMOR_TEMPLATE=ecommai-armor

# Models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_LIVE_MODEL=gemini-3.8-live
# The Live model isn't served from the global endpoint
GEMINI_LIVE_LOCATION=us-central1
EMBEDDING_DIMENSIONS=768

# Kaggle API token (starts with KGAT_), or save it to ~/.kaggle/access_token
KAGGLE_API_TOKEN=

# App
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# "dev" lets requests without a sign-in token act as a demo user. Local only: the API refuses it on Cloud Run.
AUTH_MODE=
# "off" turns Google sign-in off: each browser is its own shopper, with a request limit per address.
SIGN_IN=
# Public URL of our UCP agent profile (the deployed agent's /.well-known/ucp). Empty locally: Shopify's example profile is used.
UCP_AGENT_PROFILE_URL=
